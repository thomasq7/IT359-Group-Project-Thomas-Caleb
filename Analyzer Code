class Result:
    # holds the final score and everything we found
    def __init__(self, score, level, findings, explanation):
        self.score = score
        self.level = level
        self.findings = findings  # list of (category, points, message)
        self.explanation = explanation

    def report(self):
        lines = []
        lines.append("=" * 60)
        lines.append("RISK SCORE: " + str(self.score) + "/100 (" + self.level + " RISK)")
        lines.append("=" * 60)
        lines.append(self.explanation)
        lines.append("")
        if len(self.findings) == 0:
            lines.append("Nothing suspicious found.")
        else:
            lines.append("Details:")
            # biggest problems first
            for category, points, message in sorted(self.findings, key=lambda f: -f[1]):
                lines.append("  [" + category.ljust(11) + "] +" + str(points).ljust(2) + " " + message)
        lines.append("")
        lines.append("Note: this tool isn't perfect. Check with the sender another way")
        lines.append("before clicking or replying.")
        return "\n".join(lines)


def get_main_domain(host):
    # turns mail.example.com into example.com
    host = host.lower().strip(".")
    parts = host.split(".")
    if len(parts) <= 2:
        return host
    if ".".join(parts[-2:]) in TWO_PART_TLDS:
        return ".".join(parts[-3:])
    return ".".join(parts[-2:])


def get_tld(host):
    if "." not in host:
        return ""
    return host.lower().split(".")[-1]


def fake_brand(domain):
    # checks if a domain is pretending to be a brand (like paypa1-secure.com)
    main = get_main_domain(domain)
    name = main.split(".")[0]
    # undo letter swaps so paypa1 becomes paypal
    swapped = name.replace("0", "o").replace("1", "l").replace("rn", "m").replace("vv", "w")
    other_parts = domain.replace("-", ".").split(".")[:-2]

    for brand in BRANDS:
        if main in BRANDS[brand]:
            continue  # it's the real one
        if name.startswith(brand) or brand in name.split("-"):
            return brand
        if swapped != name and brand in swapped:
            return brand
        if brand in other_parts:  # like paypal.login-check.xyz
            return brand
    return None
